# Observatorio API — plantilla .env
# Uso: cp .env.example .env && chmod 600 .env

API_ENV=development
API_DEBUG=true
API_TIMEZONE=America/El_Salvador

# Orígenes permitidos (coma-separados). Puertos de dev: 8901 cascarón,
# 8902 app/, 8903 panel/, 8904 muro/.
CORS_ALLOWED_ORIGINS=http://localhost:8901,http://127.0.0.1:8901,http://localhost:8902,http://127.0.0.1:8902,http://localhost:8903,http://127.0.0.1:8903,http://localhost:8904,http://127.0.0.1:8904

# Contrato app — header X-App-Secret desde el front (mismo valor en runtime local).
# Generar: openssl rand -hex 24
API_SECRET=cambiar_en_produccion
# off | monitor | strict — en producción SIEMPRE strict, va en TODAS las peticiones
# (ver CLAUDE.md, "X-App-Secret va en todas las peticiones"), no solo /catalogos.
API_SECRET_ENFORCE=strict

# Base de datos (PostgreSQL + PostGIS). En docker-compose.dev.yml el host es "db".
DB_HOST=db
DB_PORT=5432
DB_NAME=observatorio
DB_USER=observatorio
DB_PASSWORD=cambiar_en_desarrollo
# prefer | require — bases administradas (DigitalOcean, etc.) exigen require.
DB_SSLMODE=prefer

# Cifra los respaldos generados en el panel (lib/Respaldo.php,
# docs/decision-04-respaldos.md). Generar una clave fuerte de verdad
# (ej. openssl rand -base64 32) — NUNCA la de ejemplo de abajo. REDNA
# guarda su propia copia de esta misma clave fuera del servidor: es lo
# único que permite leer un respaldo ya descargado si se pierde el
# acceso al servidor.
RESPALDO_CLAVE=cambiar_en_produccion

# Rate limiting (por IP, archivo local — igual que TerroSenser)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60
RATE_LIMIT_DAILY_MAX=500

# Límite específico del contrato para /reportes/sync (api_v1.md, sección 2)
RATE_LIMIT_SYNC_MAX=60
RATE_LIMIT_SYNC_WINDOW=3600
